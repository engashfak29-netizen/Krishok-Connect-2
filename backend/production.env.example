# Copy to .env on the production server. Never commit the real file.
SECRET_KEY=REPLACE_WITH_64_PLUS_RANDOM_BYTES
DATABASE_URL=postgresql://krishok:REPLACE_PASSWORD@db:5432/krishok_connect
CORS_ORIGINS=https://YOUR-DOMAIN.example
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
MARKET_PRICE_URL=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
LOG_LEVEL=INFO
ENABLE_API_DOCS=false

# Initial launch policy
REQUIRE_ACCOUNT_VERIFICATION=false
SELLER_SUBSCRIPTION_FREE=true

# Final launch safety flags
PLATFORM_SETTLEMENT_ENABLED=false
TURN_SERVERS_JSON=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Distributed rate limiting / scaling
REDIS_URL=redis://redis:6379/0
REQUIRE_REDIS=true

# Object storage / CDN (S3-compatible: AWS S3, Cloudflare R2, MinIO, etc.)
MEDIA_STORAGE_BACKEND=local
MEDIA_DIR=/app/app/media
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_CDN_BASE_URL=
MEDIA_CDN_PUBLIC=false
MEDIA_SIGNED_URL_TTL=900

# Native mobile/web push: FCM HTTP v1
FCM_SERVICE_ACCOUNT_JSON=

# Native iOS push: APNs HTTP/2 token authentication
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_PATH=
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=false
